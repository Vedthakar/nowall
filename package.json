{
  "name": "nowall",
  "version": "0.1.0",
  "description": "When your coding agent hits its usage limit, the work keeps going in the next one.",
  "keywords": ["claude-code", "cursor", "codex", "ai-agents", "failover", "rate-limit", "cli"],
  "homepage": "https://github.com/Vedthakar/nowall#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vedthakar/nowall.git"
  },
  "bugs": {
    "url": "https://github.com/Vedthakar/nowall/issues"
  },
  "license": "MIT",
  "author": "Ved Thakar",
  "type": "module",
  "bin": {
    "nowall": "dist/cli.js"
  },
  "files": ["dist", "scripts/fake-agent.mjs", "notch/build/NowallNotch.app", "install.sh"],
  "engines": {
    "node": ">=20"
  },
  "os": ["darwin", "linux"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "stress": "npm run build && node scripts/stress.mjs",
    "prepack": "npm run build && npm run build:notch",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test",
    "build:notch": "sh scripts/build-notch.sh",
    "install:local": "npm install -g \"$(npm pack --silent | tail -1)\""
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
